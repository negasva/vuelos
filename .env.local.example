NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
CRON_SECRET=

APIFY_API_TOKEN=
APIFY_API_URL=https://api.apify.com/v2/acts/johnvc~google-flights-data-scraper/run-sync-get-dataset-items

# Telegram notifications (used by the price-tracking cron to send alerts)
TELEGRAM_BOT_TOKEN=
# Optional fallback chat id used when a tracked flight's user has no telegram_chat_id
TELEGRAM_DEFAULT_CHAT_ID=

# Email notifications via Resend (used by the cron)
RESEND_API_KEY=
# Optional sender; defaults to onboarding@resend.dev (Resend free tier)
RESEND_FROM=
# Optional fallback recipient when a user has no notify_email
ALERT_EMAIL_TO=

